#: .es5/templates/partial/password-strength-balloon.mustache:1
msgid "Password requirements"
msgstr "Požiadavky na heslo"

#: .es5/templates/partial/password-strength-balloon.mustache:3
msgid "At least 8 characters"
msgstr "Minimálne 8 znakov"

#: .es5/templates/partial/password-strength-balloon.mustache:6
msgid "Not your email address"
msgstr "Nie je to vaša e‑mailová adresa"

#: .es5/templates/partial/password-strength-balloon.mustache:10
msgid "Not a commonly used password"
msgstr "Nie je to bežne používané heslo"

#: .es5/templates/partial/password-strength-balloon.mustache:11
msgid "Stay safe &mdash; don’t reuse passwords. See more tips to <a %(escapedCommonPasswordLinkAttrs)s class=\"link-grey\">create strong passwords</a>."
msgstr "Zostaňte v bezpečí &mdash; nepoužívajte opakovane svoje heslá. Pozrite si ďalšie tipy ako <a %(escapedCommonPasswordLinkAttrs)s class=\"link-grey\">vytvoriť silné heslá</a>."
