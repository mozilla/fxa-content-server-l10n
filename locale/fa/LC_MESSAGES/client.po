#: .es5/templates/partial/unsupported-pair.mustache:1
msgid "Connecting your mobile device with your Mozilla account"
msgstr "اتصال دستگاه همراه شما به حساب موزیلا"

#: .es5/templates/partial/unsupported-pair.mustache:2
msgid "Open Firefox on your computer, visit <b class=\"whitespace-nowrap\">firefox.com/pair</b>, and follow the on-screen instructions to connect your mobile device."
msgstr "فایرفاکس را در رایانه خود باز کنید، به <b class=\"whitespace-nowrap\">firefox.com/pair</b> بروید و دستورالعمل‌های روی صفحه را برای اتصال دستگاه همراه خود دنبال کنید."

#: .es5/templates/pair/auth_allow.mustache:1
msgid "Did you just sign in to Firefox?"
msgstr "آیا همین الان وارد فایرفاکس شدید؟"

#: .es5/templates/pair/auth_allow.mustache:2
msgid " %(email)s "
msgstr " %(email)s "

#: .es5/templates/pair/auth_allow.mustache:3
msgid "location balloon"
msgstr "حباب مکان"

#: .es5/templates/pair/auth_allow.mustache:4
msgid "Yes, approve device"
msgstr "بله، دستگاه را تأیید می‌کنم"

#: .es5/templates/pair/auth_allow.mustache:5
msgid "If this wasn’t you, <a id=\"change-password\" class=\"link-blue\">change your password</a> "
msgstr "اگر این کار شما نبوده است، <a id=\"change-password\" class=\"link-blue\">گذرواژه خود را تغییر دهید</a> "

#: .es5/templates/pair/auth_complete.mustache:1
msgid "You’re ready to send some tabs"
msgstr "آماده‌اید چند زبانه را ارسال کنید"

#: .es5/templates/pair/auth_complete.mustache:2 .es5/templates/pair/auth_complete.mustache:7
msgid "Successfully connected"
msgstr "با موفقیت متصل شد"

#: .es5/templates/pair/auth_complete.mustache:3
msgid ""
"\n"
"          <span>%(deviceFamily)s for %(deviceOS)s</span> is connected.\n"
"        "
msgstr ""
"\n"
"          <span>%(deviceFamily)s برای %(deviceOS)s</span> متصل است.\n"
"        "

#: .es5/templates/pair/auth_complete.mustache:4
msgid "You’re free to instantly send open tabs, passwords, and bookmarks between devices."
msgstr "می‌توانید فوراً زبانه‌های باز، گذرواژه‌ها و نشانک‌ها را بین دستگاه‌ها ارسال کنید."

#: .es5/templates/pair/auth_complete.mustache:6 .es5/templates/pair/success.mustache:1
msgid "Device connected"
msgstr "دستگاه متصل شد"

#: .es5/templates/pair/auth_complete.mustache:8
msgid ""
"\n"
"          You are now syncing with: <span>%(deviceFamily)s on %(deviceOS)s</span>\n"
"        "
msgstr ""
"\n"
"          اکنون با <span>%(deviceFamily)s روی %(deviceOS)s</span> در حال همگام‌سازی هستید.\n"
"        "

#: .es5/templates/pair/auth_complete.mustache:9
msgid "Now you can access your open tabs, passwords, and bookmarks on all your devices."
msgstr "اکنون می‌توانید به زبانه‌های باز، گذرواژه‌ها و نشانک‌های خود در همه دستگاه‌هایتان دسترسی داشته باشید."

#: .es5/templates/pair/auth_complete.mustache:10
msgid "See tabs from synced devices"
msgstr "زبانه‌های دستگاه‌های همگام‌شده را ببینید"

#: .es5/templates/pair/auth_complete.mustache:12
msgid "Manage devices"
msgstr "مدیریت دستگاه‌ ها"

#: .es5/templates/pair/auth_wait_for_supp.mustache:1 .es5/templates/pair/supp_wait_for_auth.mustache:1
msgid "Approval now required <small class=\"card-subheader\">from your other device</small>"
msgstr "اکنون تأیید <small class=\"card-subheader\">از دستگاه دیگر شما</small> لازم است"

#: .es5/templates/pair/failure.mustache:1
msgid "Device pairing failed"
msgstr "جفت‌سازی دستگاه ناموفق بود"

#: .es5/templates/pair/failure.mustache:2
msgid "The setup couldn’t be completed. Please sign in with your email."
msgstr "راه‌اندازی کامل نشد. لطفاً با رایانامه خود وارد شوید."

#: .es5/templates/pair/index.mustache:1
msgid "Password created. You’re now syncing."
msgstr "گذرواژه ایجاد شد. اکنون در حال همگام‌سازی هستید."

#: .es5/templates/pair/index.mustache:3
msgid "Account created. You’re now syncing."
msgstr "حساب ایجاد شد. اکنون در حال همگام‌سازی هستید."

#: .es5/templates/pair/index.mustache:5
msgid "Signed in successfully!"
msgstr "ورود با موفقیت انجام شد!"

#: .es5/templates/pair/index.mustache:11
msgid "Download or open Firefox on the device where you want to send tabs"
msgstr "فایرفاکس را در دستگاهی که می‌خواهید زبانه‌ها را به آن ارسال کنید دریافت یا باز کنید"

#: .es5/templates/pair/index.mustache:14
msgid "Sync your Firefox experience"
msgstr "تجربه فایرفاکس خود را همگام کنید"

#: .es5/templates/pair/index.mustache:15
msgid "Download Firefox for mobile"
msgstr "فایرفاکس را برای موبایل دریافت کنید"

#: .es5/templates/pair/index.mustache:17
msgid "View your saved passwords, tabs, browsing history and more — across all your devices."
msgstr "گذرواژه‌های ذخیره‌شده، زبانه‌ها، تاریخچه مرور و موارد دیگر را در همه دستگاه‌های خود ببینید."

#: .es5/templates/pair/index.mustache:18
msgid "Select an option to continue:"
msgstr "برای ادامه یک گزینه را انتخاب کنید:"

#: .es5/templates/pair/index.mustache:19
msgid "I already have Firefox for mobile"
msgstr "من از قبل فایرفاکس برای موبایل را دارم"

#: .es5/templates/pair/index.mustache:20
msgid "Start your sync now if you already have Firefox on your mobile device."
msgstr "اگر از قبل فایرفاکس را در دستگاه همراه خود دارید، همین حالا همگام‌سازی را شروع کنید."

#: .es5/templates/pair/index.mustache:21
msgid "I don’t have Firefox for mobile"
msgstr "من فایرفاکس برای موبایل ندارم"

#: .es5/templates/pair/index.mustache:22
msgid "Download Firefox on your mobile device, then start your sync."
msgstr "فایرفاکس را در دستگاه همراه خود دریافت کنید، سپس همگام‌سازی را شروع کنید."

#: .es5/templates/pair/index.mustache:24 .es5/templates/pair/index.mustache:30
msgid "Not now"
msgstr "فعلاً نه"

#: .es5/templates/pair/index.mustache:25
msgid "To sync Firefox on your phone or tablet, you first need to download Firefox for mobile. Here’s how:"
msgstr "برای همگام‌سازی فایرفاکس در تلفن یا تبلت خود، ابتدا باید فایرفاکس برای موبایل را دریافت کنید. روش کار این است:"

#: .es5/templates/pair/index.mustache:26
msgid "<b>Step 1</b>: Download Firefox by scanning this QR code with the camera on your mobile device:"
msgstr "<b>مرحله ۱</b>: با اسکن این کد QR با دوربین دستگاه همراه خود، فایرفاکس را دریافت کنید:"

#: .es5/templates/pair/index.mustache:27
msgid "QR code (located in the middle of the screen)"
msgstr "کد QR (در وسط صفحه)"

#: .es5/templates/pair/index.mustache:28
msgid "<b>Step 2</b>: Select \"Continue to sync\" to sync your Firefox experience on your mobile device."
msgstr "<b>مرحله ۲</b>: برای همگام‌سازی تجربه فایرفاکس در دستگاه همراه خود، «ادامه همگام‌سازی» را انتخاب کنید."

#: .es5/templates/pair/index.mustache:29
msgid "Continue to sync"
msgstr "ادامه همگام‌سازی"

#: .es5/templates/pair/success.mustache:2
msgid "Device successfully paired"
msgstr "دستگاه با موفقیت جفت شد"

#: .es5/templates/pair/success.mustache:3
msgid "Pairing was successful."
msgstr "جفت سازی موفقیت آمیز بود."

#: .es5/templates/pair/supp_allow.mustache:1
msgid "Confirm pairing <span class=\"card-subheader\">for <span class=\"break-all\">%(email)s</span></span>"
msgstr "جفت‌سازی <span class=\"card-subheader\">برای <span class=\"break-all\">%(email)s</span> را تأیید کنید</span>"

#: .es5/templates/pair/supp_allow.mustache:2
msgid "Confirm pairing"
msgstr "تأیید جفت شدن"

#: .es5/templates/pair/unsupported.mustache:3 .es5/templates/pair/unsupported.mustache:13
msgid "Oops! It looks like you’re not using Firefox."
msgstr "اوه! به نظر می‌رسد از فایرفاکس استفاده نمی‌کنید."

#: .es5/templates/pair/unsupported.mustache:4 .es5/templates/pair/unsupported.mustache:12
msgid "Attention:"
msgstr "توجه:"

#: .es5/templates/pair/unsupported.mustache:5
msgid "Switch to Firefox and open this page to connect another device."
msgstr "به فایرفاکس بروید و این صفحه را باز کنید تا دستگاه دیگری را متصل کنید."

#: .es5/templates/pair/unsupported.mustache:6
msgid "Download Firefox"
msgstr "دریافت فایرفاکس"

#: .es5/templates/pair/unsupported.mustache:7
msgid "Opens in new window"
msgstr "در پنجره جدید باز می‌شود"

#: .es5/templates/pair/unsupported.mustache:9
msgid "Pair using an app"
msgstr "جفت سازی با استفاده از برنامه"

#: .es5/templates/pair/unsupported.mustache:10
msgid "Did you use the system camera? You must pair from within a Firefox app."
msgstr "آیا از دوربین سیستم استفاده کردید؟ شما باید از درون یک برنامه فایرفاکس جفت سازی کنید."

#: .es5/templates/pair/unsupported.mustache:14
msgid "Download Firefox now"
msgstr "فایرفاکس را همین حالا دریافت کنید"

#: .es5/templates/pair/unsupported.mustache:17
msgid "Oops! Something went wrong."
msgstr "اوه! مشکلی پیش آمد."

#: .es5/templates/pair/unsupported.mustache:18
msgid "Please close this tab and try again."
msgstr "لطفاً این زبانه را ببندید و دوباره تلاش کنید."
